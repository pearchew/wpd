# Leave all of these blank to run on built-in dummy prices.
# Copy to .env.local for local runs (npm run dev, db:check, db:backfill).

# Supabase (server only: never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Prices come from Yahoo Finance (no key). To use Twelve Data instead, set both of these (see lib/feed/).
PRICE_FEED=
PRICE_API_KEY=

# Vercel cron sends this as a Bearer token; set the same value in Vercel env vars
CRON_SECRET=

# Failure alerts from the daily job (Resend)
RESEND_API_KEY=
ALERT_EMAIL=

# Team admin (/admin). See README, "Team admin".
# GitHub OAuth app for sign-in; callback URL: https://<your site>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Any long random string; signs the sign-in cookie
ADMIN_SESSION_SECRET=
# Who may sign in: githublogin:initials, comma-separated
ADMIN_USERS=
# Fine-grained token with Contents + Pull requests read/write on this repo only; opens the pull requests
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BASE_BRANCH=main
# Local only: sign in as these initials without GitHub during `npm run dev`. Ignored in production.
ADMIN_DEV_USER=
